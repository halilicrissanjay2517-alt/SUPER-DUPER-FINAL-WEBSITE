        "code": "        <section class=\"features\" id=\"features\">\n            <div class=\"section-head\">\n                <span class=\"eyebrow eyebrow-dark\">Portal modules</span>\n                <h2 class=\"section-title\">School Features</h2>\n                <p class=\"section-text\">Simple access points for common school information and student services.</p>\n            </div>\n\n            <div class=\"feature-grid\">\n                <article class=\"feature-card stagger\" id=\"announcements\">\n                    <span class=\"feature-icon\" aria-hidden=\"true\">\n                        <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M3 10v4h4l5 4V6l-5 4H3Zm13.5 2a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Z\"/></svg>\n                    </span>\n                    <h3>Announcements</h3>\n                    <p>View school updates, reminders, and important notices as soon as they are posted.</p>\n                    <a class=\"card-link\" href=\"features.html#announcements\">Read announcements &rarr;</a>\n                </article>\n\n                <article class=\"feature-card stagger\" id=\"enrollment\">\n                    <span class=\"feature-icon\" aria-hidden=\"true\">\n                        <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M4 4h11l5 5v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm10 1.5V10h4.5L14 5.5ZM7 13h10v2H7v-2Zm0 4h10v2H7v-2Z\"/></svg>\n                    </span>\n                    <h3>Enrollment</h3>\n                    <p>Find enrollment steps, requirements, and deadlines for every grade level.</p>\n                    <a class=\"card-link\" href=\"features.html#enrollment\">Start enrollment &rarr;</a>\n                </article>\n"
      }
    },

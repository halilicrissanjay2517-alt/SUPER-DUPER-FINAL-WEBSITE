        "code": "        <section class=\"sub-hero\">\n            <div class=\"sub-hero-bg\" aria-hidden=\"true\"></div>\n            <div class=\"section-inner sub-hero-inner\">\n                <nav class=\"crumbs\" aria-label=\"Breadcrumb\">\n                    <a href=\"studentportal.html\">Home</a>\n                    <span aria-hidden=\"true\">/</span>\n                    <span aria-current=\"page\">Faculty &amp; Staff</span>\n                </nav>\n                <span class=\"eyebrow eyebrow-light\">Our people &middot; one school</span>\n                <h1>Faculty &amp; Staff</h1>\n                <p class=\"lead\">\n                    The teachers, formators, and office personnel who keep Saint Patrick's Academy\n                    running — arranged by department and office, with the right contact for each\n                    concern.\n                </p>\n\n                <div class=\"sub-hero-actions\">\n                    <a class=\"btn btn-gold\" href=\"#staff-login\">Staff sign-in</a>\n                    <a class=\"btn btn-ghost-light\" href=\"studentportal.html#contact\">Ask the office</a>\n                </div>\n            </div>\n        </section>\n\n        <!-- Jump navigation -->\n        <nav class=\"sub-nav\" aria-label=\"On this page\">"

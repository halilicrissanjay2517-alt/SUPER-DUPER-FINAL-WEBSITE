        "endLine": 161,
        "code": "      <section class=\"sub-hero\">\n        <div class=\"sub-hero-bg\" aria-hidden=\"true\"></div>\n        <div class=\"section-inner sub-hero-inner\">\n          <nav class=\"crumbs\" aria-label=\"Breadcrumb\">\n            <a href=\"studentportal.html\">Home</a>\n            <span aria-hidden=\"true\">/</span>\n            <span aria-current=\"page\">About Us</span>\n          </nav>\n          <span class=\"eyebrow eyebrow-light\"\n            >Established 1968 &middot; Dingalan, Aurora</span\n          >\n          <h1>More than half a century of forming students</h1>\n          <p class=\"lead\">\n            Saint Patrick's Academy, Inc. is a non-stock, non-profit Catholic\n            institution serving the families of Dingalan and the wider province\n            of Aurora. This is our story — who we are named for, how we grew,\n            and what our students have achieved.\n          </p>\n\n          <div class=\"sub-hero-actions\">\n            <a class=\"btn btn-gold\" href=\"#history\">Our history</a>\n            <a class=\"btn btn-ghost-light\" href=\"#band\"\n              >Band championship record</a\n            >\n          </div>"
      }
    },

    {
      "id": "FIG-18",
      "image": "../04-faculty-departments.png",
      "page": "faculty.html",
      "title": "faculty — departments",
      "viewport": "1366 × 900",
      "explanation": "Lists teaching departments and explains where to direct academic concerns.",
      "source": {
        "file": "faculty.html",
        "startLine": 130,
        "endLine": 155,
        "code": "            <section class=\"detail\" id=\"departments\">\n                <div class=\"detail-head\">\n                    <span class=\"detail-num\" aria-hidden=\"true\">01</span>\n                    <div>\n                        <span class=\"eyebrow eyebrow-dark\">Teaching</span>\n                        <h2 class=\"section-title\">Academic departments</h2>\n                        <p class=\"muted\">Every learning area, with the subjects it handles.</p>\n                    </div>\n                </div>\n\n                <div class=\"detail-body\">\n                    <div class=\"detail-copy\">\n                        <h3>How the faculty is organised</h3>\n                        <p>\n                            Teachers belong to the learning area they teach and are led by a\n                            department head, who reports to the Academic Coordinator. Class advisers\n                            are assigned per section and are the first point of contact for parents.\n                        </p>\n\n                        <h3>Who to approach</h3>\n                        <ol class=\"steps-list\">\n                            <li>Subject or grade concern — the subject teacher first.</li>\n                            <li>Section-level concern — the class adviser.</li>\n                            <li>Curriculum or load concern — the department head, then the Academic Coordinator.</li>\n                        </ol>\n"
      }
    },
    {
      "id": "FIG-19",
      "image": "../04-faculty-offices.png",
      "page": "faculty.html",
      "title": "faculty — offices",
      "viewport": "1366 × 900",
      "explanation": "Explains the responsibilities of non-teaching school offices.",
      "source": {
        "file": "faculty.html",
        "startLine": 180,
        "endLine": 205,
        "code": "            <section class=\"detail\" id=\"offices\">\n                <div class=\"detail-head\">\n                    <span class=\"detail-num\" aria-hidden=\"true\">02</span>\n                    <div>\n                        <span class=\"eyebrow eyebrow-dark\">Non-teaching</span>\n                        <h2 class=\"section-title\">School offices</h2>\n                        <p class=\"muted\">The staff who handle records, money, and student support.</p>\n                    </div>\n                </div>\n\n                <div class=\"detail-body\">\n                    <div class=\"detail-copy\">\n                        <h3>What each office does</h3>\n                        <p>\n                            Non-teaching personnel are grouped by function rather than by subject.\n                            Each office keeps its own records, so a concern is settled fastest when it\n                            goes straight to the office that owns it.\n                        </p>\n\n                        <h3>Office contact guide</h3>\n                        <ol class=\"steps-list\">\n                            <li>Records, certifications and Form 137 — Registrar's Office.</li>\n                            <li>Fees, receipts and balances — Accounting Office.</li>\n                            <li>Counseling and student welfare — Guidance Office.</li>\n                            <li>Accounts and portal problems — IT Support.</li>\n                        </ol>"
      }
    },
    {
      "id": "FIG-20",
      "image": "../04-faculty-staff-login.png",
      "page": "faculty.html",
      "title": "faculty — staff-login",
      "viewport": "1366 × 900",
      "explanation": "Links staff to admin.html, which uses the existing administrator roles.",
      "source": {
        "file": "faculty.html",
        "startLine": 225,
        "endLine": 250,
        "code": "            <section class=\"detail\" id=\"staff-login\">\n                <div class=\"detail-head\">\n                    <span class=\"detail-num\" aria-hidden=\"true\">03</span>\n                    <div>\n                        <span class=\"eyebrow eyebrow-dark\">Staff access</span>\n                        <h2 class=\"section-title\">Staff sign-in</h2>\n                        <p class=\"muted\">Separate from student accounts — staff records are confidential.</p>\n                    </div>\n                </div>\n\n                <div class=\"detail-body\">\n                    <div class=\"detail-copy\">\n                        <h3>Why staff sign in separately</h3>\n                        <p>\n                            Student records, grades, and balances are private. Staff accounts carry\n                            teacher-level or office-level permissions, so the staff sign-in stays\n                            apart from the Student Portal that students and parents use.\n                        </p>\n\n                        <h3>Getting an account</h3>\n                        <ol class=\"steps-list\">\n                            <li>Ask the school office to create your staff account.</li>\n                            <li>Sign in and change the temporary password you were given.</li>\n                            <li>Report a lost password to the IT Support office for a reset.</li>\n                        </ol>\n"
      }
    },

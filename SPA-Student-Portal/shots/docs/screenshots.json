        "code": "            <section class=\"detail\" id=\"payments\">\n                <div class=\"detail-head\">\n                    <span class=\"detail-num\" aria-hidden=\"true\">04</span>\n                    <div>\n                        <span class=\"eyebrow eyebrow-dark\">Service four</span>\n                        <h2 class=\"section-title\">Payments &amp; balances</h2>\n                        <p class=\"muted\">How to pay, and how to read your own payment history.</p>\n                    </div>\n                </div>\n\n                <div class=\"detail-body\">\n                    <div class=\"detail-copy\">\n                        <h3>What it is for</h3>\n                        <p>\n                            Each payment you make is recorded against your account with a\n                            receipt number, so your balance always reflects what has actually\n                            been settled — and you keep a full history rather than a bare total.\n                        </p>\n\n                        <h3>How to use it</h3>\n                        <ol class=\"steps-list\">\n                            <li>Check your current balance before paying.</li>\n                            <li>Pay through the cashier or an accepted channel.</li>\n                            <li>Keep the receipt number — it is the reference for any query.</li>\n                        </ol>\n                    </div>"

        "code": "            <section class=\"detail\" id=\"enrollment\">\n                <div class=\"detail-head\">\n                    <span class=\"detail-num\" aria-hidden=\"true\">02</span>\n                    <div>\n                        <span class=\"eyebrow eyebrow-dark\">Service two</span>\n                        <h2 class=\"section-title\">Enrollment</h2>\n                        <p class=\"muted\">Requirements, steps, and deadlines for every grade level.</p>\n                    </div>\n                </div>\n\n                <div class=\"detail-body\">\n                    <div class=\"detail-copy\">\n                        <h3>What it is for</h3>\n                        <p>\n                            A walk-through of the enrollment process from form request to\n                            section assignment, with the exact documents the registrar needs\n                            and the dates that matter.\n                        </p>\n\n                        <h3>How to use it</h3>\n                        <ol class=\"steps-list\">\n                            <li>Check the current enrollment window and deadline.</li>\n                            <li>Prepare the listed requirements before visiting the office.</li>\n                            <li>Submit to the registrar and keep your reference number.</li>\n                        </ol>\n                    </div>"
      }
    },

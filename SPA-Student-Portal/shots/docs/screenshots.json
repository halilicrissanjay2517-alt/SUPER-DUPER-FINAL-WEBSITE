        "startLine": 214,
        "endLine": 239,
        "code": "            <section class=\"detail\" id=\"records\">\n                <div class=\"detail-head\">\n                    <span class=\"detail-num\" aria-hidden=\"true\">03</span>\n                    <div>\n                        <span class=\"eyebrow eyebrow-dark\">Service three</span>\n                        <h2 class=\"section-title\">Student records</h2>\n                        <p class=\"muted\">Your details, grade level, section, and account status.</p>\n                    </div>\n                </div>\n\n                <div class=\"detail-body\">\n                    <div class=\"detail-copy\">\n                        <h3>What it is for</h3>\n                        <p>\n                            A read-only view of the record the school holds for you — name,\n                            grade level, section, standing, and any balance on your account.\n                            If something looks wrong, the records office corrects it at source.\n                        </p>\n\n                        <h3>How to use it</h3>\n                        <ol class=\"steps-list\">\n                            <li>Sign in with your student account.</li>\n                            <li>Open the records section and check each field.</li>\n                            <li>Report any discrepancy to the records office with your ID.</li>\n                        </ol>\n"
      }

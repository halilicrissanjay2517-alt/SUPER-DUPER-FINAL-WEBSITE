# Node
node_modules/
npm-debug.log*

# The live database — this holds real students' names, contact details, tuition
# balances and hashed passwords. It must never be committed or uploaded to a
# public repo. The server creates a fresh seeded workbook if it is missing.
database.xlsx

# Local backups and one-off audit/scratch files
#
# Everything in this section is scratch work that belongs on your machine and
# NOT in the published repo: throwaway QA probes, repair scripts, seed data with
# plaintext passwords, and runtime logs. They are ignored by pattern rather than
# by name so that OneDrive restoring them (which silently undoes a delete) can
# never push them back into a commit.
*.xlsx
!node_modules/**/*.xlsx

# Backup copies of the live workbook. These hold the same real student records
# and password hashes as database.xlsx, so they must never be committed either.
# The pattern is deliberately broad (database.backup-*.xlsx and friends) because
# a backup tool naming its own copies is exactly how one gets committed by
# accident.
database.*.xlsx
_dbtools_*.xlsx
_db_*.xlsx
_backup_*.xlsx
*.xlsx.bak
_snap.xlsx

# One-off browser/QA probes and repair scripts
_qa_*.mjs
_flowcheck.cjs
_fixline.cjs
_repair.cjs
_seed.json
_check.cjs

# The live database (repeated here so the rule is impossible to miss)
database.xlsx

# Server logs (runtime output, no value in version control)
*.log
srv-out.log
srv-err.log
_srv_out.log
_srv_err.log
_srv2_out.log
_srv2_err.log

# Local environment / secrets
.env
.env.local

# Runtime data folder. On a host DB_DIR points at the mounted disk; if you also
# run it locally with DB_DIR set, the workbook may land in this folder. Either
# way it must never be committed — it holds every student record and password
# hash.
data/

# OS / editor noise
Thumbs.db
.DS_Store

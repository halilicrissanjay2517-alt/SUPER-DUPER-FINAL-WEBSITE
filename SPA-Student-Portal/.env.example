# ---------------------------------------------------------------------------
# Environment variables for the Student Portal.
#
# Copy this file to ".env" only as a reminder of what to set — the server reads
# real environment variables, not this file. On a hosting platform, add these
# under the project's "Environment" / "Config Vars" settings instead.
# ---------------------------------------------------------------------------

# Passwords for the two seeded logins. REQUIRED on a public host: the server
# refuses to create a database with the default passwords when PORT is set.
SPA_ADMIN_PASSWORD=put-a-long-random-password-here
SPA_REGISTRAR_PASSWORD=put-another-long-random-password-here

# The address students will actually open, used only for the startup banner.
# Example: https://portal.saintpatricks.edu.ph
# If you leave this out the banner prints localhost, which is harmless.
SPA_PUBLIC_URL=

# Port. Most hosting platforms set this for you — do not set it by hand on one,
# or you will fight the platform. Locally the default is 3000.
# PORT=3000

# Folder holding database.xlsx. Leave unset locally (the file sits next to
# server.js). On a host it MUST point inside the mounted persistent disk, or
# every change is lost when the service restarts. Render: DB_DIR=/var/data with
# the disk mounted at /var/data.
# DB_DIR=/var/data
